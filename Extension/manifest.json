{
  "manifest_version": 3,
  "name": "Hedwig Shield",
  "short_name": "Hedwig",
  "version": "1.0.0",
  "description": "Real-time phishing and malicious website protection powered by Hedwig's threat intelligence.",

  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "32":  "assets/icons/icon32.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Hedwig Shield"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-analyzer.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "activeTab",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.groq.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": []
  },

  "web_accessible_resources": [
    {
      "resources": ["ui/warning.html", "assets/mascot.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.groq.com"
  }
}
